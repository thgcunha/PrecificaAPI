# Valores para o PostgreSQL de desenvolvimento local.
POSTGRES_DB=precifica
POSTGRES_USER=precifica
POSTGRES_PASSWORD=precifica_local
POSTGRES_PORT=5432

# O Prisma usa POSTGRES_* para o Docker local se DATABASE_URL estiver ausente.
# Em hospedagem, configure DATABASE_URL e, para migrations, DIRECT_DATABASE_URL.
# SEED_ADMIN_PASSWORD=
# SEED_OPERADOR_PASSWORD=
